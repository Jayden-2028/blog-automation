# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Service role key (Project Settings > API) - server-side only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Naver Developers > Application (News/Blog/Web Search + DataLab Search Trend API 공용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Telegram Bot (keyword-notification 워크플로우 발송용)
# 1) @BotFather와 대화해서 /newbot으로 봇을 만들면 토큰을 받는다.
# 2) 알림을 받을 채팅(개인 DM 또는 채널/그룹)에 봇을 추가한 뒤, 아무 메시지나 보내고
#    https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates 를 열어 chat.id 값을 확인한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 인스타 포스팅 변환기 - 기존 알림 봇과 완전히 분리된 별도 봇(2026-09-21).
# 1) @BotFather에서 /newbot으로 새 봇을 만들고 이름은 자유(예: "인스타 포스팅 변환기").
# 2) 그 봇과 DM을 열고 아무 메시지나 보낸 뒤
#    https://api.telegram.org/bot<INSTAGRAM_BOT_TOKEN>/getUpdates 로 chat.id 확인.
# INSTAGRAM_BOT_CHAT_ID를 비워두면 아무 chat에서 온 메시지나 받는다(테스트용) - 운영 시엔 반드시 채운다.
INSTAGRAM_BOT_TOKEN=
INSTAGRAM_BOT_CHAT_ID=

# 캡처 자동화(2026-09-22, docs/ai-handoff/INSTAGRAM_CAPTURE_AUTOMATION.md).
# 텔레그램으로 URL을 받은 뒤 캐러셀 캡처 -> job 생성 -> 자료조사까지 사람 없이 이어서 한다.
# 기본은 꺼져 있다 - 로그인 프로필이 준비되기 전에 켜면 매 분 실패 알림이 온다.
# 1) 맥에서 Playwright용 크롬 프로필을 하나 만들고 그걸로 인스타에 로그인해 둔다.
# 2) 그 프로필 디렉터리 경로를 IG_BROWSER_PROFILE에 넣는다(맥 전용 - 클라우드 러너엔 없다).
# 3) 한 건을 수동으로 확인한 뒤 IG_CAPTURE_AUTO=true로 켠다.
IG_CAPTURE_AUTO=false
IG_BROWSER_PROFILE=
# 캐러셀이 길 때 찍을 상한(기본 10).
IG_CAPTURE_MAX_SLIDES=10

# 대체 이미지 리버스 검색(2026-09-23, 설계서 2-b단계).
# 텍스트 검색은 "같은 주제 사진"이라 엉뚱한 출처가 붙는다. 구글 렌즈에 슬라이드를 올리면
# **같은 사진**이 실린 페이지를 돌려준다.
# 1) npm run ig:lens-login  -> 창이 열리면 구글에 로그인(인스타 프로필과 분리한다)
# 2) LENS_REVERSE_SEARCH=true로 켠다
# 렌즈는 자동화 트래픽에 CAPTCHA를 띄운다. 막히면 기존 텍스트 검색으로 자동으로 떨어지므로
# 파이프라인은 멈추지 않는다. LENS_HEADLESS=false로 창을 띄워 눈으로 볼 수 있다.
LENS_REVERSE_SEARCH=false
LENS_BROWSER_PROFILE=

# ── 자료조사 provider (Claude 사용량 절약, 2026-09-02) ──────────────
# 자료조사 단계(researcher 에이전트)는 기본으로 claude -p를 헤드리스로 부른다. 이 단계가
# WebSearch를 반복하는 파이프라인에서 가장 무거워, gemini로 분리하면 Claude 사용량을 크게 아낄
# 수 있다(집필/OSMU 배리에이션은 블로그 스킬 의존 때문에 계속 claude를 쓴다 - 여긴 안 바뀜).
# 기본값은 claude이므로 아래를 안 건드리면 기존 동작 그대로다.
RESEARCH_PROVIDER=claude
# Google AI Studio(aistudio.google.com/apikey)에서 발급.
GEMINI_API_KEY=
GEMINI_RESEARCH_MODEL=gemini-3.6-flash
# Gemini 호출 실패(쿼터·네트워크 등) 시 같은 job에 한해 claude로 자동 폴백할지.
RESEARCH_FALLBACK_TO_CLAUDE=true

# NAVER Creator Advisor 트렌드 탭(동적 키워드 소스) - 기본은 비활성화.
# BrowserCreatorAdvisorProvider는 여기 credential 대신 CREATOR_ADVISOR_PROFILE_DIR의
# Playwright persistent profile(수동 로그인된 브라우저 세션)을 사용한다.
CREATOR_ADVISOR_ENABLED=false
# Creator Advisor에 연동된 본인 네이버 블로그 ID.
# trends 페이지가 https://creator-advisor.naver.com/naver_blog/{이 값}/trends 형태로 고정되어 있다.
CREATOR_ADVISOR_BLOG_ID=
# trends 페이지에서 수집할 최대 topic card(Swiper 슬라이드) 개수.
# 실측 기준 계정의 topic은 11개이며 Swiper 순회로 전체를 약 5초에 수집한다. 줄이면 뒤쪽
# topic(영화, 일상·생각 등)이 통째로 빠지므로 특별한 이유가 없으면 11을 유지한다.
CREATOR_ADVISOR_MAX_TOPICS=11
CREATOR_ADVISOR_MAX_KEYWORDS_PER_TOPIC=20
CREATOR_ADVISOR_REQUEST_DELAY_MS=2000
CREATOR_ADVISOR_CANDIDATE_TTL_HOURS=24
CREATOR_ADVISOR_PROFILE_DIR=.local/creator-advisor-profile

# ---------- 동적 키워드 소스 (config/trendSources.ts) ----------
# trend_candidates.source별 on/off와 quota. 어떤 소스가 꺼져 있거나 실패해도 daily job은
# seed_queries + 나머지 소스로 정상 동작한다.

# 구글 트렌드 "Trending now" RSS - 인증/브라우저 불필요, 2026-08-29 실측 검증 완료.
# **코드 기본값이 true라 이 줄이 없어도 켜져 있다.** 끌 때만 false로 명시한다.
# 확인: npm run collect:google-trends  (기본 dry-run, category 분포까지 출력)
# GOOGLE_TRENDS_ENABLED=false
GOOGLE_TRENDS_MAX_DAILY_CANDIDATES=10
GOOGLE_TRENDS_CANDIDATE_TTL_HOURS=12

# 다음 실시간 트렌드 - 수집기 미구현(설계만 완료). 구현 전까지 켜지 말 것.
DAUM_REALTIME_ENABLED=false
DAUM_REALTIME_MAX_DAILY_CANDIDATES=8
DAUM_REALTIME_CANDIDATE_TTL_HOURS=8

# 커뮤니티(네이트판/더쿠/카페 인기글) - 수집기 미구현(설계만 완료). 구현 전까지 켜지 말 것.
COMMUNITY_TRENDS_ENABLED=false
COMMUNITY_TRENDS_MAX_DAILY_CANDIDATES=12
COMMUNITY_TRENDS_MAX_CANDIDATES_PER_SITE=4
COMMUNITY_TRENDS_CANDIDATE_TTL_HOURS=18

# ── Sprint 5: 다채널 발행 ──────────────────────────────────────────
# Blogspot (Blogger API v3) - 완전 자동 발행.
# GCP 콘솔 > OAuth 클라이언트 ID(데스크톱 앱)에서 발급. SPRINT_5_DESIGN.md §8/§10-1.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
# Blogger 관리화면 URL의 blogID= 뒤 숫자.
BLOGGER_BLOG_ID=
# `npm run setup:blogger` 실행 후 출력되는 값을 붙여넣는다.
BLOGGER_REFRESH_TOKEN=
BLOGGER_ENABLED=false
# 가동 첫 며칠은 true(비공개 draft)로 두고 형태 확인 후 false(공개)로.
BLOGGER_PUBLISH_AS_DRAFT=true
BLOGGER_DAILY_LIMIT=5

# 티스토리 - 반자동(임시저장까지). Playwright + 수동 로그인된 프로필.
TISTORY_ENABLED=false
TISTORY_BLOG_URL=https://wooahpapa.tistory.com/
TISTORY_PROFILE_DIR=.local/tistory-publish-profile
TISTORY_DAILY_LIMIT=5

# 채널별 원고 페이지(manuscripts/index.html) Cloudflare Pages 자동 배포 - 셋 다 있어야 켜진다.
# 설정 방법: docs/ai-handoff/CURRENT_STATE.md "Cloudflare Pages 설정" 참고.
CLOUDFLARE_PAGES_PROJECT_NAME=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 블로그 경쟁도(포화도) 측정.
# 상위 후보의 주제어를 LLM으로 뽑아(헤드리스 1회) 블로그 문서 총 개수를 조회한다.
# 기본은 **측정만** - 로그에 "켜면 몇 점이 되는지" preview가 찍히고 순위는 그대로다.
# BLOG_COMPETITION_PROBE_ENABLED=false   # 측정 자체를 끄려면
# ⚠️ APPLY_TO_SCORE=true는 6-factor scoring 변경이다. 사용자 승인 없이 켜지 않는다.
BLOG_COMPETITION_APPLY_TO_SCORE=false
# 포화도 정규화 구간(2026-09-04 확정, run #34~35 Top 18 분포 기준). 자릿수 기준 10^2 / 10^5.
BLOG_COMPETITION_LOW_TOTAL=100
BLOG_COMPETITION_HIGH_TOTAL=100000

# 같은 주제 cluster 2차 병합 - 기본은 preview만(로그로 무엇이 합쳐질지 보여주고 실제로는 미적용).
# TOPIC_MERGE_PREVIEW_ENABLED=false      # preview 계산도 끄려면
# ⚠️ APPLY=true는 clustering 로직 변경이다. 사용자 승인 없이 켜지 않는다.
TOPIC_MERGE_APPLY=false

# ── Google Search Console 성과 수집(2026-09-21) ──────────────────
# Blogger와 달리 OAuth 동의가 필요 없다 - 서비스 계정 JSON 전문을 그대로 넣는다.
# 1) console.cloud.google.com(blog-automation 프로젝트) > "Search Console API" 사용 설정
# 2) IAM 및 관리자 > 서비스 계정 만들기 > 키(JSON) 다운로드
# 3) search.google.com/search-console > 설정 > 사용자 및 권한 > 그 서비스 계정 이메일 추가(전체)
# 키 전문을 한 줄로 붙여넣는다(줄바꿈이 \n으로 굳어도 코드가 되돌린다).
GSC_SERVICE_ACCOUNT_JSON=
# 속성 주소. URL 접두어 속성이면 끝에 슬래시까지: https://whynowissue.blogspot.com/
# 도메인 속성이면: sc-domain:whynowissue.blogspot.com
GSC_SITE_URL=

# 네이버용 배리에이션(뷰어의 네이버 복사 버튼). 2026-09-21부터 기본 꺼짐 - 채널이 Blogspot
# 하나인데 원고마다 LLM 호출이 한 번 더 돌아 2~5분을 먹었다. 네이버를 다시 쓰면 true로 켠다.
NAVER_VARIANT_ENABLED=false

# ── 구글 이미지 검색(2026-09-21) ─────────────────────────────────
# 네이버 이미지 검색과 **함께** 쓴다. 색인이 달라 후보가 넓어진다 - 한국 연예는 네이버가,
# 스포츠 현장·해외 인물은 구글이 강하다. 둘 다 없거나 한도를 넘겨도 수집은 멈추지 않는다.
# 무료 하루 100건(원고 1건에 자리 5개면 하루 20건까지 무료).
# 1) console.cloud.google.com(blog-automation) > "Custom Search API" 사용 설정
# 2) 사용자 인증 정보 > API 키 만들기
# 3) programmablesearchengine.google.com > 검색엔진 만들기 > "전체 웹 검색" > 이미지 검색 켜기
#    > 만든 뒤 "검색엔진 ID"(cx) 복사
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
