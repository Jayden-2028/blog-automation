# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Service role key (Project Settings > API) - server-side only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Naver Developers > Application (News/Blog/Web Search + DataLab Search Trend API 공용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Telegram Bot (keyword-notification 워크플로우 발송용)
# 1) @BotFather와 대화해서 /newbot으로 봇을 만들면 토큰을 받는다.
# 2) 알림을 받을 채팅(개인 DM 또는 채널/그룹)에 봇을 추가한 뒤, 아무 메시지나 보내고
#    https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates 를 열어 chat.id 값을 확인한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NAVER Creator Advisor 트렌드 탭(동적 키워드 소스) - 기본은 비활성화.
# BrowserCreatorAdvisorProvider는 여기 credential 대신 CREATOR_ADVISOR_PROFILE_DIR의
# Playwright persistent profile(수동 로그인된 브라우저 세션)을 사용한다.
CREATOR_ADVISOR_ENABLED=false
# Creator Advisor에 연동된 본인 네이버 블로그 ID.
# trends 페이지가 https://creator-advisor.naver.com/naver_blog/{이 값}/trends 형태로 고정되어 있다.
CREATOR_ADVISOR_BLOG_ID=
# trends 페이지에서 수집할 최대 topic card(Swiper 슬라이드) 개수.
# 실측 기준 계정의 topic은 11개이며 Swiper 순회로 전체를 약 5초에 수집한다. 줄이면 뒤쪽
# topic(영화, 일상·생각 등)이 통째로 빠지므로 특별한 이유가 없으면 11을 유지한다.
CREATOR_ADVISOR_MAX_TOPICS=11
CREATOR_ADVISOR_MAX_KEYWORDS_PER_TOPIC=20
CREATOR_ADVISOR_REQUEST_DELAY_MS=2000
CREATOR_ADVISOR_CANDIDATE_TTL_HOURS=24
CREATOR_ADVISOR_PROFILE_DIR=.local/creator-advisor-profile

# ---------- 동적 키워드 소스 (config/trendSources.ts) ----------
# trend_candidates.source별 on/off와 quota. 어떤 소스가 꺼져 있거나 실패해도 daily job은
# seed_queries + 나머지 소스로 정상 동작한다.

# 구글 트렌드 "Trending now" RSS - 인증/브라우저 불필요, 2026-08-29 실측 검증 완료.
# **코드 기본값이 true라 이 줄이 없어도 켜져 있다.** 끌 때만 false로 명시한다.
# 확인: npm run collect:google-trends  (기본 dry-run, category 분포까지 출력)
# GOOGLE_TRENDS_ENABLED=false
GOOGLE_TRENDS_MAX_DAILY_CANDIDATES=10
GOOGLE_TRENDS_CANDIDATE_TTL_HOURS=12

# 다음 실시간 트렌드 - 수집기 미구현(설계만 완료). 구현 전까지 켜지 말 것.
DAUM_REALTIME_ENABLED=false
DAUM_REALTIME_MAX_DAILY_CANDIDATES=8
DAUM_REALTIME_CANDIDATE_TTL_HOURS=8

# 커뮤니티(네이트판/더쿠/카페 인기글) - 수집기 미구현(설계만 완료). 구현 전까지 켜지 말 것.
COMMUNITY_TRENDS_ENABLED=false
COMMUNITY_TRENDS_MAX_DAILY_CANDIDATES=12
COMMUNITY_TRENDS_MAX_CANDIDATES_PER_SITE=4
COMMUNITY_TRENDS_CANDIDATE_TTL_HOURS=18

# ── Sprint 5: 다채널 발행 ──────────────────────────────────────────
# Blogspot (Blogger API v3) - 완전 자동 발행.
# GCP 콘솔 > OAuth 클라이언트 ID(데스크톱 앱)에서 발급. SPRINT_5_DESIGN.md §8/§10-1.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
# Blogger 관리화면 URL의 blogID= 뒤 숫자.
BLOGGER_BLOG_ID=
# `npm run setup:blogger` 실행 후 출력되는 값을 붙여넣는다.
BLOGGER_REFRESH_TOKEN=
BLOGGER_ENABLED=false
# 가동 첫 며칠은 true(비공개 draft)로 두고 형태 확인 후 false(공개)로.
BLOGGER_PUBLISH_AS_DRAFT=true
BLOGGER_DAILY_LIMIT=5

# 티스토리 - 반자동(임시저장까지). Playwright + 수동 로그인된 프로필.
TISTORY_ENABLED=false
TISTORY_BLOG_URL=https://wooahpapa.tistory.com/
TISTORY_PROFILE_DIR=.local/tistory-publish-profile
TISTORY_DAILY_LIMIT=5

# 블로그 경쟁도(포화도) 측정 - Phase A는 "측정만" 하고 점수에는 반영하지 않는다.
# 최종 Top 10의 canonical keyword로 블로그 검색을 1회씩 더 호출해 문서 총 개수(total)를 받는다
# (10회 x 150ms 약 2초). 순위/알림 내용에는 영향이 없다.
# BLOG_COMPETITION_PROBE_ENABLED=false   # 프로브 자체를 끄려면
# ⚠️ APPLY_TO_SCORE=true는 6-factor scoring 변경이다. 사용자 승인 없이 켜지 않는다.
BLOG_COMPETITION_APPLY_TO_SCORE=false
# 포화도 정규화 구간(블로그 문서 수). Phase A 관측(npm run debug:blog-competition) 후 확정할 잠정치.
BLOG_COMPETITION_LOW_TOTAL=300
BLOG_COMPETITION_HIGH_TOTAL=50000

# 같은 주제 cluster 2차 병합 - 기본은 preview만(로그로 무엇이 합쳐질지 보여주고 실제로는 미적용).
# TOPIC_MERGE_PREVIEW_ENABLED=false      # preview 계산도 끄려면
# ⚠️ APPLY=true는 clustering 로직 변경이다. 사용자 승인 없이 켜지 않는다.
TOPIC_MERGE_APPLY=false
