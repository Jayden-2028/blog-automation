# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Service role key (Project Settings > API) - server-side only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Naver Developers > Application (News/Blog/Web Search + DataLab Search Trend API 공용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Telegram Bot (keyword-notification 워크플로우 발송용)
# 1) @BotFather와 대화해서 /newbot으로 봇을 만들면 토큰을 받는다.
# 2) 알림을 받을 채팅(개인 DM 또는 채널/그룹)에 봇을 추가한 뒤, 아무 메시지나 보내고
#    https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates 를 열어 chat.id 값을 확인한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NAVER Creator Advisor 트렌드 탭(동적 키워드 소스) - 기본은 비활성화.
# BrowserCreatorAdvisorProvider는 여기 credential 대신 CREATOR_ADVISOR_PROFILE_DIR의
# Playwright persistent profile(수동 로그인된 브라우저 세션)을 사용한다.
CREATOR_ADVISOR_ENABLED=false
# Creator Advisor에 연동된 본인 네이버 블로그 ID.
# trends 페이지가 https://creator-advisor.naver.com/naver_blog/{이 값}/trends 형태로 고정되어 있다.
CREATOR_ADVISOR_BLOG_ID=
# trends 페이지에서 수집할 최대 topic card(Swiper 슬라이드) 개수.
# 실측 기준 계정의 topic은 11개이며 Swiper 순회로 전체를 약 5초에 수집한다. 줄이면 뒤쪽
# topic(영화, 일상·생각 등)이 통째로 빠지므로 특별한 이유가 없으면 11을 유지한다.
CREATOR_ADVISOR_MAX_TOPICS=11
CREATOR_ADVISOR_MAX_KEYWORDS_PER_TOPIC=20
CREATOR_ADVISOR_REQUEST_DELAY_MS=2000
CREATOR_ADVISOR_CANDIDATE_TTL_HOURS=24
CREATOR_ADVISOR_PROFILE_DIR=.local/creator-advisor-profile
